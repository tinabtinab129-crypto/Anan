local function isDowned()
   if not Humanoid then return false end
   return (
       Humanoid:GetAttribute("HasBeenDowned")
       or Humanoid:GetAttribute("IsDead")
       or Humanoid.Health <= 0
   )
end

local function getHRP()
   return Root
end

local function teleportUnderground()
   local hrp = getHRP()
   if not hrp then return end
   _G.AntiDeadBaseCFrame = hrp.CFrame + Vector3.new(0, _G.AntiDeadDropDepth, 0)
   hrp.CFrame = _G.AntiDeadBaseCFrame
end

local function flickerAndMove()
   if _G.AntiDeadFlickering then return end
   _G.AntiDeadFlickering = true
   task.spawn(function()
       while _G.AntiDeadFlickering and _G.AntiDeadEnabled and isDowned() do
           local hrp = getHRP()
           if hrp and _G.AntiDeadBaseCFrame then
               local angle = math.random() * math.pi * 2
               local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * _G.AntiDeadMoveRadius
               local randomPos = _G.AntiDeadBaseCFrame.Position + offset
               hrp.CFrame = CFrame.new(randomPos)
               task.wait(0.05)
               hrp.CFrame = _G.AntiDeadBaseCFrame
           end
           task.wait(_G.AntiDeadFlickerRate)
       end
       _G.AntiDeadFlickering = false
   end)
end

