local function HookButton(btn, highlightPlay, isPlay)
    if not btn then return end
    if typeof(getconnections) ~= "function" then return end
    if highlightPlay then
        local highlight = Instance.new("UIStroke")
        highlight.Color = Color3.fromRGB(0, 200, 0)
        highlight.Thickness = 3
        highlight.Parent = btn
        task.delay(0.5, function()
            if highlight and highlight.Parent then highlight:Destroy() end
        end)
    end
    for _, eventName in ipairs({"Activated","MouseButton1Click"}) do
        local event = btn[eventName]
        if event then
            local ok, conns = pcall(getconnections, event)
            if ok and conns then
                for _, conn in ipairs(conns) do
                    if conn.Function then
                        pcall(conn.Function)
                    end
                end
            end
        end
    end
    if isPlay then
        _G.playPressed = true
    else
        _G.skipPressed = true
    end
end

local function PressPlayThenSkip()
    if LocalPlayer.Character then return end
    task.wait(1)
    local splash = LocalPlayer.PlayerGui:FindFirstChild("SplashScreenGui")
    if splash and not _G.playPressed then
        local frame = splash:FindFirstChild("Frame")
        local playButton = frame and frame:FindFirstChild("PlayButton")
        if playButton then
            HookButton(playButton, true, true)
