    end
    task.wait(2)
    local creator = LocalPlayer.PlayerGui:FindFirstChild("CharacterCreator")
    if creator and not _G.skipPressed then
        local menuFrame = creator:FindFirstChild("MenuFrame")
        local skipButton = menuFrame and menuFrame:FindFirstChild("AvatarMenuSkipButton")
        if skipButton then
            HookButton(skipButton, false, false)
        end
    end
end

