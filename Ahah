local BASE_SPEED = 40

local PATH_CONFIGS = {
    { radius = 2.5, spacing = nil },
    { radius = 2, spacing = nil },
    { radius = 1.5, spacing = nil },
}

local function CreateAgentPath(radius, waypointSpacing)
    local ok, p = pcall(function()
        return PathfindingService:CreatePath({
            AgentCanJump = true,
            AgentHeight = 4,
            AgentRadius = radius or 2,
            AgentMaxSlope = 100,
            WaypointSpacing = 4,
            AgentJumpRadius = 60,
            AgentJumpHeight = 70,
            Costs = { DoorArea = 1; BlockedNode = 50 }
        })
    end)
    return ok and p or nil
end

local function GetPathLength(waypoints)
    local total = 0
    for i = 2, #waypoints do
        total = total + (waypoints[i].Position - waypoints[i-1].Position).Magnitude
    end
    return total
end

function ModuleService:Teleport(Destination, waypointSpacing)
    if IsTeleporting and (tick() - TeleportStartTime) < 15 then return end
    IsTeleporting = true
    TeleportStartTime = tick()
    self._cancelTeleport = false

    local OK, Err = pcall(function()
        local targetPos
        if typeof(Destination) == "Vector3" then
            targetPos = Destination
        elseif type(Destination) == "table" then
            local v = Destination.CFrame
            targetPos = typeof(v) == "CFrame" and v.Position or v
        end
        if not targetPos then return end

        local function TryCompute(pos, path)
            local ok = pcall(function() path:ComputeAsync(Root.Position, pos) end)
            return ok and path.Status == Enum.PathStatus.Success
        end

        local function FindBestPath()
            local bestPath, bestConfig, bestLength = nil, nil, math.huge

            for _, cfg in ipairs(PATH_CONFIGS) do
                local p = CreateAgentPath(cfg.radius, cfg.spacing or waypointSpacing)
                if not p then continue end

                local computed = TryCompute(targetPos, p)
                if not computed then
                    for _, offset in ipairs({
                        Vector3.new(0, 3, 0),
                        Vector3.new(0, 6, 0),
                        Vector3.new(2, 3, 0),
                        Vector3.new(-2, 3, 0),
                        Vector3.new(0, 3, 2),
                        Vector3.new(0, 3, -2),
                    }) do
                        if TryCompute(targetPos + offset, p) then computed = true; break end
                    end
                end

                if computed then
                    local wps = p:GetWaypoints()
                    local len = GetPathLength(wps)
                    if len < bestLength * 0.95 then
                        bestPath = p
                        bestConfig = cfg
                        bestLength = len
                    end
                end
            end

            return bestPath, bestConfig
        end

        local Path, UsedConfig = FindBestPath()
        if not Path then IsTeleporting = false; return end

        local Waypoints = Path:GetWaypoints()
        local WaypointIndex = 1
        local NeedRepath = false

        while WaypointIndex <= #Waypoints do
            if not AnyFlagOn() then break end
            if not self:IsAlive() then break end
            if self._cancelTeleport then break end

            if NeedRepath then
                NeedRepath = false
                local newPath, newConfig = FindBestPath()
                if not newPath then break end
                Path = newPath
                UsedConfig = newConfig
                Waypoints = Path:GetWaypoints()
                WaypointIndex = 1
            end

            local Waypoint = Waypoints[WaypointIndex]
            WaypointIndex = WaypointIndex + 1

            if self:Detected() then
                task.wait(2)
                NeedRepath = true
                continue
            end

            local OffsetY = (Waypoint.Action == Enum.PathWaypointAction.Jump) and 13 or 3
            local TargetPos = Waypoint.Position + Vector3.new(0, OffsetY, 0)
            local StartPos = Root.Position
            local DirVec = TargetPos - StartPos
            local Distance = DirVec.Magnitude
            if Distance < 0.1 then continue end

            local NextWP = Waypoints[WaypointIndex]
            local LookTarget = NextWP and (NextWP.Position + Vector3.new(0, OffsetY, 0)) or TargetPos
            local LookDir = LookTarget - StartPos
            local FlatLook = Vector3.new(LookDir.X, 0, LookDir.Z)

            local Dir = DirVec.Unit
            local FlatDir = FlatLook.Magnitude > 0.5 and FlatLook.Unit or Vector3.new(Dir.X, 0, Dir.Z)
            local FacingCF = (FlatDir.Magnitude > 0.01)
                and CFrame.lookAt(Vector3.zero, FlatDir)
                or CFrame.identity

            local Moved = 0
            local timeout = tick() + 10
            local lastTick = tick()

            while Moved < Distance do
                if not AnyFlagOn() then break end
                if tick() > timeout then break end
                if not self:IsAlive() then break end
                if self._cancelTeleport then break end

                if self:Detected() then
                    task.wait(2)
                    NeedRepath = true
                    break
                end

                local now = tick()
                local dt = math.min(now - lastTick, 0.067)
                lastTick = now

                Moved = math.min(Moved + BASE_SPEED * dt, Distance)
                local NewPos = StartPos + Dir * Moved

                local CurrentPos = Root.Position
                local SmoothedPos = CurrentPos:Lerp(NewPos, 0.5)

                local CurrentCF = Root.CFrame
                local TargetCF = CFrame.new(NewPos) * FacingCF
                local angleDiff = math.acos(math.clamp(CurrentCF.LookVector:Dot(TargetCF.LookVector), -1, 1))
                local lerpAlpha = math.clamp(angleDiff * 0.6, 0.08, 0.35)
                local SmoothedCF = CFrame.new(SmoothedPos) * (CurrentCF:Lerp(TargetCF, lerpAlpha) - CurrentCF.Position)

                if Humanoid.Sit then Humanoid.Sit = false end
                self[2].Send("set_sprinting_1", true)
                Root:PivotTo(SmoothedCF)

                RunService.Heartbeat:Wait()
            end
        end
    end)

    IsTeleporting = false
    return OK
end

