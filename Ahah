local function DoHackATM(self, closestATM, vehicle, hackToolClass)
    local restored = false
    local playerRestored = false
    local hackSucceeded = false
    local function safeRestore()
        if not restored and vehicle and vehicle.PrimaryPart then
            RestoreVehicle(vehicle)
            restored = true
        end
    end
    local function safeRestorePlayer()
        if not playerRestored then
            RestorePlayer()
            playerRestored = true
        end
    end
    repeat
        if not Flags.AutoATM or not self:IsAlive() then
            safeRestore() safeRestorePlayer() break
        end
        if IsDownedPaused then
            safeRestore() safeRestorePlayer() break
        end
        if Humanoid and Humanoid:GetAttribute("IsDead") then
            safeRestore() safeRestorePlayer() break
        end
        if self:Detected() then
            _G.StopDriving = true
            ATM_STATE = "IDLE"
            safeRestore()
            safeRestorePlayer()
            return hackSucceeded
        end
        if not IsATMAvailable(closestATM) then
            safeRestore() safeRestorePlayer() break
        end
        if not CheckingIsHacking() then
            if not IsATMAvailable(closestATM) then
                safeRestore() safeRestorePlayer() break
            end
            if string.lower(_G.VehicleType) == "car" then
                task.wait(0.09)
            end
            self[2].Send("request_begin_hacking_3", closestATM, hackToolClass)
            local waitOpen = tick()
            repeat
                task.wait(0.03)
                if IsDownedPaused then
                    safeRestore() safeRestorePlayer()
                    return hackSucceeded
                end
            until CheckingIsHacking() or tick() - waitOpen > 2
            if not CheckingIsHacking() then
                safeRestore()
                safeRestorePlayer()
                ATM_STATE = "FIND_ATM"
                return hackSucceeded
            end
        end

        task.wait(0.1)
        local played = AutoPlayATMMinigame(8)

        if played and not CheckingIsHacking() then
            hackSucceeded = true
        else
            if CheckingIsHacking() then
                task.wait(1.13)
                if CheckingIsHacking() then
                    self[2].Send("atm_win_3", closestATM)
                end
                hackSucceeded = true
            else
                hackSucceeded = true
            end
        end

        safeRestore()
        safeRestorePlayer()
        local waitClose = tick()
        repeat
            task.wait(0.03)
            if IsDownedPaused then return hackSucceeded end
        until not CheckingIsHacking() or tick() - waitClose > 2
    until not IsATMAvailable(closestATM) or not Flags.AutoATM or IsDownedPaused
    safeRestore()
    safeRestorePlayer()
    return hackSucceeded
end

