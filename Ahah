local function GetMopInfo(level)
    if level >= 55 then return "Diamond Mop", 1500
    elseif level >= 40 then return "Gold Mop",  800
    elseif level >= 25 then return "Silver Mop",  300
    elseif level >= 10 then return "Bronze Mop",  100
    end
    return nil, 0
end

local function GetMopTool()
    for _, name in pairs(MopNames) do
        local t = Client.Backpack:FindFirstChild(name) or Char:FindFirstChild(name)
        if t then return t, t.Parent == Char end
    end
    return nil, false
end

local function HasCorrectMop(expectedMopName)
    local t = Client.Backpack:FindFirstChild(expectedMopName) or Char:FindFirstChild(expectedMopName)
    return t ~= nil
end

local function FindMopInItems()
    for _, name in pairs(MopNames) do
        local info = GetInfo(name)
        if info[2] and info[3] then return name, info[3] end
    end
    return nil, nil
end

local function GetPuddlePriority(name)
    if name == "ToxicPuddle" then return 1
    elseif name == "OilPuddle" then return 2
    elseif name == "NastyPuddle" then return 3
    elseif name == "LargePuddle" or name == "SmallPuddle" then return 4
    end
    return 99
end

local function CanClean(name, level)
    if name == "SmallPuddle" then return true
    elseif name == "LargePuddle" then return level >= 5
    elseif name == "NastyPuddle" then return level >= 20
    elseif name == "OilPuddle" then return level >= 35
    elseif name == "ToxicPuddle" then return level >= 50
    end
    return false
end

local function IsPuddleTaken(puddle)
    local pos = GetPosition(puddle)
    if not pos then return false end
    for _, player in pairs(game.Players:GetPlayers()) do
        if player ~= Client then
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - pos).Magnitude < 5 then
                    return true
                end
            end
        end
    end
    return false
end

function ModuleService:BurgePlace()
    if not Flags.AutoJanitor then JanitorState = "INIT" return end
    if not self:IsAlive() then return end

    local map = WaitForMap(30)
    if not map then task.wait(2) return end

    if JanitorState == "INIT" then
        local lvl = self:Get_Skill_Level("Janitor")
        local mopName = GetMopInfo(lvl)

        if not mopName then
            JanitorState = "APPLY_JOB"
            return
        end

        local mop = GetMopTool()
        if mop then
            if mop.Name == mopName then
                JanitorState = "APPLY_JOB"
            else
                JanitorState = "ENSURE_MOP"
            end
            return
        end

        local ItemsGui = Client.PlayerGui:FindFirstChild("Items")
        if ItemsGui and not ItemsGui.Enabled then ItemsGui.Enabled = true end
        task.wait(0.3)

        local foundName, foundUid = FindMopInItems()
        if foundName and foundUid then
            if foundName == mopName then
                self[2].Send("toggle_equip_item", foundUid)
                task.wait(1)
            else
                JanitorState = "ENSURE_MOP"
            end
            return
        end

        JanitorState = "ENSURE_MOP"
        return
    end

    if JanitorState == "ENSURE_MOP" then
        if not self:IsAlive() then task.wait(1) return end

        local lvl = self:Get_Skill_Level("Janitor")
        local mopName, mopPrice = GetMopInfo(lvl)

        if not mopName then
            JanitorState = "APPLY_JOB"
            return
        end

        if HasCorrectMop(mopName) then
            JanitorState = "APPLY_JOB"
            return
        end

        local handMoney = HandMoney()
        local bankMoney = ATMMoney()

        if handMoney + bankMoney < mopPrice then
            JanitorState = "APPLY_JOB"
            return
        end

        if handMoney < mopPrice then
            WithdrawFromATM(self, mopPrice - handMoney)
            task.wait(1)
            return
        end

        local shopZone = workspace:WaitForChild("ShopZone_Hardware", 15)
        if not shopZone then return end

        if self:Dist(shopZone.Position) > 6 then
            self:Teleport({ CFrame = CFrame.new(shopZone.Position) })
            task.wait(1)
            return
        end

        local cooldownLeft = _purchaseCooldown - (tick() - _lastPurchaseTime)
        if cooldownLeft > 0 then task.wait(1) return end

        self[2].Send("purchase_consumable", shopZone, mopName)
        _lastPurchaseTime = tick()
        task.wait(1)

        local ItemsGui = Client.PlayerGui:FindFirstChild("Items")
        if ItemsGui and not ItemsGui.Enabled then ItemsGui.Enabled = true end
        task.wait(0.3)

        local fn, fu = FindMopInItems()
        if fn and fu then
            self[2].Send("toggle_equip_item", fu)
            task.wait(1)
        end

        JanitorState = "INIT"
        return
    end

    if JanitorState == "APPLY_JOB" then
        local BurgePlaceBeacon = workspace:FindFirstChild("BurgePlaceBeacon")
            or workspace:WaitForChild("BurgePlaceBeacon", 10)
        if not BurgePlaceBeacon then task.wait(2) return end

        local beaconPos = GetPosition(BurgePlaceBeacon)
        if not beaconPos then return end

        if ShouldDeposit() then
            self:DoDeposit(beaconPos)
            task.wait(0.3)
            self:Teleport({ CFrame = CFrame.new((Root.CFrame * CFrame.new(0, 0, 4)).Position) })
            task.wait(0.3)
            return
        end

        if self:Dist(beaconPos) > 10 then
            self:Teleport({ CFrame = beaconPos })
            return
        end

        self[2].Send("apply_for_job", BurgePlaceBeacon)
        JanitorState = "WAIT_JOB"
        task.wait(2)
        if Client:GetAttribute("Job") == "janitor" then
            JanitorState = "MOP"
        end
        return
    end

    if JanitorState == "WAIT_JOB" then
        task.wait(1)
        local job = Client:GetAttribute("Job")
        JanitorState = job == "janitor" and "MOP" or "APPLY_JOB"
        return
    end

    if Client:GetAttribute("Job") ~= "janitor" then
        JanitorState = "INIT"
        return
    end

    if JanitorState == "INIT" or JanitorState == "ENSURE_MOP" then
        return
    end

    if ShouldDeposit() then
        local BurgePlaceBeacon = workspace:FindFirstChild("BurgePlaceBeacon")
        local beaconPos = BurgePlaceBeacon and GetPosition(BurgePlaceBeacon)
        if beaconPos then
            self:DoDeposit(beaconPos)
            task.wait(0.3)
            self:Teleport({ CFrame = CFrame.new((Root.CFrame * CFrame.new(0, 0, 4)).Position) })
            task.wait(0.3)
        end
        return
    end

    if JanitorState == "MOP" then
        if ShouldDeposit() then
            local BurgePlaceBeacon = workspace:FindFirstChild("BurgePlaceBeacon")
            local beaconPos = BurgePlaceBeacon and GetPosition(BurgePlaceBeacon)
            if beaconPos then
                self:DoDeposit(beaconPos)
                task.wait(0.3)
                self:Teleport({ CFrame = CFrame.new((Root.CFrame * CFrame.new(0, 0, 4)).Position) })
                task.wait(0.3)
            end
            return
        end

        local lvl = self:Get_Skill_Level("Janitor")
        local mopName = GetMopInfo(lvl)
        local Mop, MopEquipped = GetMopTool()

        if not Mop or (mopName and Mop.Name ~= mopName) then
            JanitorState = "INIT"
            return
        end

        if not MopEquipped then
            Humanoid:EquipTool(Mop)
            task.wait(0.3)
        end

        local Level = self:Get_Skill_Level("Janitor")
        local BurgerPlace = workspace.Map.Tiles.BurgerPlaceTile:FindFirstChild("BurgerPlace")
        if not BurgerPlace then return end

        local Interior = BurgerPlace:FindFirstChild("Interior")
        if not Interior then return end

        local PuddlesFolder = Interior:FindFirstChild("Puddles")
        if not PuddlesFolder then return end

        local bestPuddle = nil
        local bestPriority = 99
        local bestDist = math.huge

        for _, v in pairs(PuddlesFolder:GetChildren()) do
            if v.Transparency < 0.99 and CanClean(v.Name, Level) then
                local p = GetPuddlePriority(v.Name)
                local d = self:Dist(GetPosition(v))
                if p < bestPriority then
                    bestPuddle = v
                    bestPriority = p
                    bestDist = d
                elseif p == bestPriority and d < bestDist then
                    bestPuddle = v
                    bestDist = d
                end
            end
        end

        if not bestPuddle then task.wait(1) return end

        JanitorState = "CLEAN"
        self._currentPuddle = bestPuddle
        return
    end

    if JanitorState == "CLEAN" then
        if ShouldDeposit() then
            JanitorState = "MOP"
            return
        end

        local Puddle = self._currentPuddle

        if not Puddle or Puddle.Transparency >= 0.99 then
            JanitorState = "MOP"
            return
        end

        local lvl = self:Get_Skill_Level("Janitor")
        local mopName = GetMopInfo(lvl)
        local Mop, MopEquipped = GetMopTool()

        if not Mop or (mopName and Mop.Name ~= mopName) then
            JanitorState = "INIT"
            return
        end

        if not MopEquipped then
            Humanoid:EquipTool(Mop)
            task.wait(0.3)
        end

        local puddlePos = GetPosition(Puddle)
        if not puddlePos then JanitorState = "MOP" return end

        if IsPuddleTaken(Puddle) then
            JanitorState = "MOP"
            return
        end

        self:Teleport({ CFrame = puddlePos })

        if IsPuddleTaken(Puddle) then
            JanitorState = "MOP"
            return
        end

        self[2].Send("start_cleaning_puddle", Puddle)

        local Changed = false
        local Conn = Puddle:GetPropertyChangedSignal("Transparency"):Connect(function()
            Changed = true
        end)

        local wt = tick() + 10
        repeat
            if IsPuddleTaken(Puddle) then
                Conn:Disconnect()
                JanitorState = "MOP"
                return
            end
            task.wait(0.3)
        until Changed or tick() > wt or not Flags.AutoJanitor

        Conn:Disconnect()

        if Puddle.Transparency >= 0.99 then
            JanitorState = "MOP"
        end
        return
    end
end

