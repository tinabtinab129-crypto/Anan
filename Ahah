local function Driveto(self, model, destination)
   _G.StopDriving = true
   task.wait()
   _G.StopDriving = false
   if not model or not model.PrimaryPart then
       ATM_STATE = "IDLE"
       return false
   end

   local detectThread = task.spawn(function()
       while not _G.StopDriving do
           task.wait(0.5)
           if IsDownedPaused then
               _G.StopDriving = true
               break
           end
           if self:Detected() then
               _G.StopDriving = true
               ATM_STATE = "FIND_ATM"
               break
           end
       end
   end)

   local isCar = string.lower(_G.VehicleType) == "car"
   local path

   local radiusList = isCar and { 9, 6, 2 } or { 2.5 }
   for _, r in ipairs(radiusList) do
       local p = CreateDrivePath(r)
       if not p then continue end
       local ok = pcall(function()
           p:ComputeAsync(model.PrimaryPart.Position, destination)
       end)
       if ok and p.Status == Enum.PathStatus.Success then
           path = p
           break
       end
   end

   if not path then
       task.cancel(detectThread)
       return false
   end

   local waypoints = path:GetWaypoints()

   local clip = model.PrimaryPart:FindFirstChild("CarClip")
   if not clip then
       clip = Instance.new("BodyVelocity")
       clip.Name = "CarClip"
       clip.MaxForce = Vector3.new(1e5, 1e5, 1e5)
       clip.P = 1250
       clip.Velocity = Vector3.zero
       clip.Parent = model.PrimaryPart
   end

   local _arrivedDest = true

   for i, waypoint in ipairs(waypoints) do
       if _G.StopDriving or IsDownedPaused then
           _arrivedDest = false
           break
       end

       local startPos = model.PrimaryPart.Position
       local goalPos = waypoint.Position + Vector3.new(0, isCar and 3.5 or 1.5, 0)
       local dir = (goalPos - startPos).Unit
       local distance = (goalPos - startPos).Magnitude
       local moved = 0
       local startT = tick()
       local jumpedOver = false

       if waypoint.Action == Enum.PathWaypointAction.Jump then
           local forwardDir = (goalPos - startPos)
           local forwardDist = forwardDir.Magnitude
           local forwardUnit = forwardDist > 0.1 and forwardDir.Unit or dir

           local obstacleHit = workspace:Raycast(
               startPos + Vector3.new(0, 1, 0),
               forwardUnit * math.min(forwardDist, 15),
               RaycastParams.new()
           )

           local shouldJump =
               (obstacleHit ~= nil and not obstacleHit.Instance:IsA("Terrain") and obstacleHit.Normal.Y < 0.95)
               or (goalPos.Y - startPos.Y) > 0.3

           if shouldJump then
               local jumpHeight = 27
               local steps = 18
               local startJump = model.PrimaryPart.Position
               local nextWp = waypoints[i + 1]
               local landPos
               if nextWp then
                   landPos = nextWp.Position + Vector3.new(0, isCar and 3.5 or 2, 0)
                   jumpedOver = true
               else
                   landPos = goalPos + forwardUnit * 6
               end
               for j = 1, steps do
                   if _G.StopDriving or IsDownedPaused then break end
                   local t2 = j / steps
                   local arc = math.sin(t2 * math.pi) * jumpHeight
                   local mid2 = startJump:Lerp(landPos, t2) + Vector3.new(0, arc, 0)
                   model:SetPrimaryPartCFrame(CFrame.lookAt(mid2, mid2 + dir))
                   RunService.Heartbeat:Wait()
               end
           end
       end

       if jumpedOver then
           continue
       end

       local conn
       conn = RunService.Heartbeat:Connect(function(delta)
           if _G.StopDriving or IsDownedPaused then
               conn:Disconnect()
               return
           end
           if moved >= distance then
               conn:Disconnect()
               return
           end
           if not Humanoid.Sit then
               conn:Disconnect()
               return
           end

           local rayParams = RaycastParams.new()
           rayParams.FilterType = Enum.RaycastFilterType.Exclude
           rayParams.FilterDescendantsInstances = { model, Character }
           local hit = workspace:Raycast(model.PrimaryPart.Position, dir * 7, rayParams)
           if hit and hit.Instance then
               local name = hit.Instance.Name:lower()
               local parent = hit.Instance.Parent and hit.Instance.Parent.Name:lower() or ""
               local isDoor = name:find("door") or parent:find("door")
               local isPole = hit.Instance.Parent and hit.Instance.Parent:IsA("Model")
               if not isDoor and not isPole then
                   local side = math.random() > 0.5 and 1 or -1
                   local dodgePos = model.PrimaryPart.Position + (model.PrimaryPart.CFrame.RightVector * side * 10)
                   model:SetPrimaryPartCFrame(CFrame.lookAt(dodgePos, dodgePos + dir))
               end
           end

           moved = math.min(moved + delta * ATM_DRIVE_SPEED, distance)

           local newPos = startPos + dir * moved
           model:SetPrimaryPartCFrame(CFrame.lookAt(newPos, newPos + dir))
           model.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
           model.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
       end)

       repeat task.wait() until moved >= distance or _G.StopDriving or IsDownedPaused
       if conn then conn:Disconnect() end
       if not _arrivedDest then break end
   end

   task.cancel(detectThread)
   local old = model.PrimaryPart:FindFirstChild("CarClip")
   if old then old:Destroy() end

   local finalDist = (model.PrimaryPart.Position - destination).Magnitude
   if not _arrivedDest or finalDist > ATM_ARRIVE_DIST + 5 then
       return false
   end
   return true
end

