    return CoreData.money.hand >= Settings.DepositThreshold
end

local function GetProgressBar()
    local pg = Client.PlayerGui:FindFirstChild("ProgressBar")
    if not pg then return nil end
    local frame = pg:FindFirstChild("ProgressBarFrame")
    if not frame then return nil end
    return frame
end

local function GetProgressScale()
    local frame = GetProgressBar()
    if not frame then return 0 end
    local bar = frame:FindFirstChild("MainFrame")
    if not bar then return 0 end
    local amount = bar:FindFirstChild("BarAmount")
    if not amount then return 0 end
    return amount.Size.X.Scale
