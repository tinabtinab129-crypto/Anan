function ModuleService:AutoATM()
  if not Flags.AutoATM then ATM_STATE = "IDLE" return end
  if not self:IsAlive() then task.wait(3) return end
  if IsDownedPaused then task.wait(1) return end
  if Humanoid and Humanoid:GetAttribute("IsDead") then task.wait(3) return end
  if self:Detected() then
      _G.StopDriving = true
      ATM_STATE = "IDLE"
      task.wait(2)
      return
  end

  if Flags.AutoSteak and _G._steakPausedByATM then
      Flags.AutoSteak = false
      _G._steakPausedByATM = false
      SteakState = "INIT"
  end

  local totalLevel = Client:GetAttribute("level") or 0
  local hand = HandMoney()
  local bank = ATMMoney() or 0
  local hasVehicle = GetVehicleItemFromInventory()[2]

  if totalLevel < 10 then
      if not Flags.AutoSteak then
          Flags.AutoSteak = true
          _G._steakPausedByATM = true
          SteakState = "INIT"
      end
      self:SteakHouse()
      return
  end

  if not hasVehicle and hand + bank < BMX_PRICE then
      if not Flags.AutoSteak then
          Flags.AutoSteak = true
          _G._steakPausedByATM = true
          SteakState = "INIT"
      end
      self:SteakHouse()
      return
  end

  if not hasVehicle and bank >= (BMX_PRICE - hand) then
      local currentHand = HandMoney()
      if currentHand < BMX_PRICE then
          local atmForWd, _ = GetBestATM()
          if atmForWd then
              local atmStandPos = GetATMStandPos(atmForWd)
              if (Root.Position - atmStandPos).Magnitude > ATM_INTERACT_DIST then
                  self:Teleport({ CFrame = CFrame.new(atmStandPos) })
                  task.wait(0.5)
              end
              if not IsATMDisabled(atmForWd) then
                  self[2].Get("transfer_funds", "bank", "hand", BMX_PRICE - currentHand)
                  task.wait(0.5)
              end
          end
          return
      end
  end

  if not hasVehicle then
      ATM_STATE = "BUY_VEHICLE"
      if hand < BMX_PRICE then
          self[2].Get("transfer_funds", "bank", "hand", BMX_PRICE - hand)
          task.wait(0.05)
          return
      end
      local shopPos, crate = GetBMXShopPos()
      if not shopPos then return end
      if self:Dist(shopPos) > 6 then
          self:Teleport({ CFrame = CFrame.new(shopPos) })
          task.wait(1)
          return
      end
      local crateOptions = crate:WaitForChild("CrateOptions", 10)
      local basicOption = crateOptions and crateOptions:WaitForChild("Basic", 10)
      if not basicOption then return end
      self[2].Get("open_crate", basicOption, "money")
      task.wait(2)
      self:Teleport({ CFrame = CFrame.new(253.70, 255.21, -202.66) })
      task.wait(1)
      return
  end

  ATM_STATE = "ENSURE_VEHICLE"

  if ATM_STATE == "ENSURE_VEHICLE" then
      if not Humanoid.Sit then
          if _standingStart == nil then
              _standingStart = tick()
          elseif tick() - _standingStart > 300 then
              TeleportService:Teleport(game.PlaceId, Client)
              return
          end
      else
          _standingStart = nil
      end
  else
      _standingStart = nil
  end

  local vehicleData = nil
  local itemInfo = GetVehicleItemFromInventory()
  if itemInfo[2] then
      pcall(function()
          local ItemUtils = require(game.ReplicatedStorage.Modules.Game.Inventory.ItemUtils)
          vehicleData = ItemUtils.get_item_info(CoreData, itemInfo[3])
      end)
  end

  if vehicleData and (vehicleData.destroyed or (vehicleData.health ~= nil and vehicleData.health <= 0)) then
      if IsDownedPaused then return end
      RepairVehicleByGuid(self, itemInfo[3])
      return
  end

  local vehicle = EnsureOnVehicle(self)
  if not vehicle then
      task.wait(2)
      return
  end

  EnsureVehicleLocked(self, vehicle)

  if vehicleData and GetVehicleHPPercent(vehicle) <= VEHICLE_REPAIR_THRESHOLD then
      if Humanoid.Sit then
          DismountVehicle(self, vehicle)
          task.wait(0.3)
      end
      RepairVehicle(self, vehicle)
      return
  end

  local HACK_TOOL_PRIORITY = {
      "HackToolBasic",
      "HackToolPro",
      "HackToolUltimate",
      "HackToolQuantum",
  }

  local activeHackTool = _G.HackToolClass
  if activeHackTool == "Automatic" then
      local swiper = self:Get_Skill_Level("Swiper")
      if swiper >= 90 then
          if IsQuantumInStock() then
              activeHackTool = "HackToolQuantum"
          else
              activeHackTool = "HackToolUltimate"
          end
      elseif swiper >= 50 then
          activeHackTool = "HackToolUltimate"
      elseif swiper >= 12 then
          activeHackTool = "HackToolPro"
      else
          activeHackTool = "HackToolBasic"
      end
  end

  local hasHack = GetInfo(activeHackTool)[2]
  if not hasHack then
      for _, tier in ipairs(HACK_TOOL_PRIORITY) do
          if tier == activeHackTool then break end
          if GetInfo(tier)[2] then
              activeHackTool = tier
              hasHack = true
              break
          end
      end
  end

  if not hasHack then
      ATM_STATE = "BUY_HACKTOOL"
      local hand2 = HandMoney()
      local bank2 = ATMMoney() or 0
      local totalMoney = hand2 + bank2

      local targetTool = activeHackTool
      local priceEach = GetChipPrice(targetTool)

      if totalMoney < priceEach then
          local fallbackTool = nil
          for _, tier in ipairs(HACK_TOOL_PRIORITY) do
              if tier == activeHackTool then break end
              local tierPrice = GetChipPrice(tier)
              if totalMoney >= tierPrice and not GetInfo(tier)[2] then
                  fallbackTool = tier
              end
          end

          if not fallbackTool then
              if not Flags.AutoSteak then
                  Flags.AutoSteak = true
                  _G._steakPausedByATM = true
                  SteakState = "INIT"
              end
              self:SteakHouse()
              return
          end

          targetTool = fallbackTool
          priceEach = GetChipPrice(targetTool)
      end

      local affordAmount = math.floor(totalMoney / priceEach)
      local buyAmount = math.max(1, math.min(_G.HackToolAmount, affordAmount))
      local needMoney = priceEach * buyAmount

      if hand2 < needMoney then
          if IsDownedPaused then return end
          local need = needMoney - hand2
          local atmForWd, _ = FindBestATM()
          if not atmForWd then task.wait(2) return end
          local atmPos = GetATMFrontPos(atmForWd)
          local arrivedAtmForWd = atmForWd

          if (Root.Position - atmPos).Magnitude > ATM_ARRIVE_DIST then
              local rerouteThread = task.spawn(function()
                  while not _G.StopDriving do
                      task.wait(0.5)
                      if IsDownedPaused then
                          _G.StopDriving = true
                          break
                      end
                      if not IsATMAvailable(atmForWd) then
                          _G.StopDriving = true
                          break
                      end
                      local newATM, newDist = FindBestATM()
                      if newATM and newATM ~= atmForWd then
                          local curDist = (Root.Position - GetATMFrontPos(atmForWd)).Magnitude
                          if newDist < curDist - 25 then
                              atmForWd = newATM
                              atmPos = GetATMFrontPos(atmForWd)
                              arrivedAtmForWd = atmForWd
                              _G.StopDriving = true
                              break
                          end
                      end
                  end
              end)

              local arrived = Driveto(self, vehicle, atmPos)
              task.cancel(rerouteThread)
              task.wait(0.1)
              if not arrived then task.wait(1) return end
          end

          if IsDownedPaused then return end
          if self:Detected() then
              _G.StopDriving = true
              ATM_STATE = "IDLE"
              task.wait(0.5) return
          end

