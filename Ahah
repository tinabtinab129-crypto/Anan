          _G.StopDriving = true
          ATM_STATE = "IDLE"
          task.wait(0.5)
          return
      end

      if not IsATMAvailable(closestATM) then return end
  end

  if IsDownedPaused then return end

  if vehicle and vehicle.PrimaryPart then
      vehicle.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
      vehicle.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
  end

  ATM_STATE = "ARRIVED_ATM"

  if IsDownedPaused then return end

  if vehicle and vehicle.PrimaryPart then
      DisableVehicleCollision(vehicle)
  end

  if not DismountVehicle(self, vehicle) then
      if vehicle and vehicle.PrimaryPart then RestoreVehicleCollision(vehicle) end
