  end

  if vehicle and vehicle.PrimaryPart then
      RestoreVehicleCollision(vehicle)
  end

  local distAfterDismount = (Root.Position - atmFrontPos).Magnitude
  if distAfterDismount > 2.5 then
      Root:PivotTo(CFrame.new(atmFrontPos))
      task.wait(0.1)
  end

  if isBack then
      local atmPos = closestATM:GetPivot().Position
      local dir = Vector3.new(atmPos.X - Root.Position.X, 0, atmPos.Z - Root.Position.Z)
      if dir.Magnitude > 0.1 then
          Root:PivotTo(CFrame.new(Root.Position, Root.Position - dir.Unit))
      end
      task.wait(0.05)
  end

  task.wait(0.01)
  SuspendPlayer(0)

  if ShouldDeposit() then
      self[2].Get("transfer_funds", "hand", "bank", CoreData.money.hand)
      task.wait(0.2)
  end

  if not IsATMAvailable(closestATM) then
      if vehicle and vehicle.PrimaryPart then RestoreVehicle(vehicle) end
      RestorePlayer()
      return
  end

  ATM_STATE = "HACKING"
  local hackSucceeded = DoHackATM(self, closestATM, vehicle, activeHackTool)

  if hackSucceeded then
      _atmLastHacked[closestATM] = tick()
  end

  task.wait(0.3)

  if self:Detected() then
      _G.StopDriving = true
      ATM_STATE = "FIND_ATM"
      task.wait(0.5)
      return
  end

  local waitDone = tick()
  repeat task.wait(0.03) until not CheckingIsHacking() or tick() - waitDone > 2
  task.wait(0.2)

  ATM_STATE = "FIND_ATM"

  local exitPos = GetATMExitPos(closestATM)
  if exitPos then
      MountAndExitIfNeeded(self, vehicle, closestATM)
      task.wait(0.3)
      local currentVehicle = GetMyVehicle()
      if currentVehicle and Humanoid.Sit then
          Driveto(self, currentVehicle, exitPos)
          task.wait(0.3)
      end
  else
      MountAndExitIfNeeded(self, vehicle, closestATM)
   end
end

