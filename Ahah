function ModuleService:Bypass()
    local ok, err = pcall(function()
        local Security
        if debug and debug.getupvalue then
            local s = debug.getupvalue(CoreNet.send, 2)
            if s and pcall(function()
                return debug.getinfo(s).what == "Lua"
            end) then
                Security = s
            end
        end
        if not Security and getgc then
            for _, v in pairs(getgc(true)) do
                if type(v) == "function" then
                    local ok2, info = pcall(debug.getinfo, v)
                    if ok2 and info and info.what == "Lua" then
                        Security = v
                        break
                    end
                end
            end
        end
        if not Security then error("Bypass Failed.") end
        self[1].Hookfunction(Security, function(f, ...) return f(...) end)
    end)
    if not ok then
        warn("[Bypass] error:", err)
        return
    end

    local Core = {
        Send = self[1].Clonefunction(CoreNet.send),
        Get = self[1].Clonefunction(CoreNet.get),
    }
    self[2].Send = function(...)
        if type(select(1,...)) ~= "string" then return end
        return Core.Send(...)
    end
    self[2].Get = function(...)
        if type(select(1,...)) ~= "string" then return end
        return Core.Get(...)
    end
end

function ModuleService:Closest(Folder, Condition, Pivot)
    if not Folder then return nil end
    Condition = Condition or function() return true end
    local best, bestDist = nil, math.huge
    for _, v in pairs(Folder:GetChildren()) do
        if not Condition(v) then continue end
        local pos = GetPosition(v)
        if not pos then continue end
        local origin = Pivot or Root.Position
        local d = (origin - pos).Magnitude
        if d < bestDist then best = v bestDist = d end
    end
    return best
end

