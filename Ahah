local function ApplyBoostToInstance(v)
   pcall(function()
       if v:IsA("BasePart") then
           v.Material = Enum.Material.SmoothPlastic
           v.Reflectance = 0
           v.CastShadow = false
       elseif v:IsA("ParticleEmitter")
           or v:IsA("Trail")
           or v:IsA("Beam")
           or v:IsA("Smoke")
           or v:IsA("Fire")
           or v:IsA("Sparkles")
           or v:IsA("Highlight")
       then
           v.Enabled = false
       elseif v:IsA("Decal") or v:IsA("Texture") then
           v.Transparency = 1
       elseif v:IsA("SpecialMesh") or v:IsA("MeshPart") then
           pcall(function() v.RenderFidelity = Enum.RenderFidelity.Performance end)
       elseif v:IsA("SurfaceAppearance") then
           v.Parent = nil
       elseif v:IsA("Sound") then
           v.Volume = 0
       end
   end)
end

