local ATM_INTERACT_DIST = 4
local ATM_STAND_OFFSET = 5

local function GetATMStandPos(atm)
    local cf = atm:IsA("Model") and atm.PrimaryPart and atm.PrimaryPart.CFrame
        or (atm:IsA("BasePart") and atm.CFrame)
    if cf then
        local frontPos = (cf * CFrame.new(0, 0, ATM_STAND_OFFSET)).Position + Vector3.new(0, 0.5, 0)
        local backPos = (cf * CFrame.new(0, 0, -ATM_STAND_OFFSET)).Position + Vector3.new(0, 0.5, 0)
        local distFront = (Root.Position - frontPos).Magnitude
        local distBack = (Root.Position - backPos).Magnitude
        local best = distFront < distBack and frontPos or backPos
        local dir = (best - (atm:IsA("Model") and atm:GetPivot().Position or atm.Position))
        if dir.Magnitude > 0 then
            best = best + dir.Unit * 1.5
        end
        return best
    end
    return atm:IsA("Model") and atm:GetPivot().Position or atm.Position
end

local function IsATMDisabled(atm)
    for _, obj in next, ModuleATM.class.objects do
        if obj.instance == atm then
            return obj.states.disabled.get() == true
        end
    end
    return true
end

local function GetBestATM()
    local best, bestDist = nil, math.huge
    for _, obj in next, ModuleATM.class.objects do
        local atm = obj.instance
        if not atm then continue end
        if obj.states.disabled.get() == true then continue end
        local pos = atm:IsA("Model") and atm:GetPivot().Position or atm.Position
        local d = (Root.Position - pos).Magnitude
        if d < bestDist then
            best = atm
            bestDist = d
        end
    end
    return best, bestDist
end

local function WithdrawFromATM(self, amount)
    local ATM = GetBestATM()
    if not ATM then return false end
    local standPos = GetATMStandPos(ATM)
    local dist = (Root.Position - standPos).Magnitude
    if dist > ATM_INTERACT_DIST then
        self:Teleport({ CFrame = CFrame.new(standPos) })
        task.wait(0.5)
        local newDist = (Root.Position - standPos).Magnitude
        if newDist > ATM_INTERACT_DIST then return false end
    end
    if IsATMDisabled(ATM) then return false end
    self[2].Get("transfer_funds", "bank", "hand", amount)
    task.wait(0.3)
    return true
end

function ModuleService:DoDeposit(nearPos)
    if IsDownedPaused then return false end
    local timeout = 30
    local recheckRate = 0.5
    local ATM, atmDist = GetBestATM()
    if not ATM then return false end
    local arrived = false
    local globalStart = tick()

    while not arrived do
        if IsDownedPaused then return false end
        if tick() - globalStart > timeout then return false end

        if IsATMDisabled(ATM) then
            IsTeleporting = false
            local better, betterDist = GetBestATM()
            if not better then return false end
            ATM = better
            atmDist = betterDist
            task.wait(recheckRate)
            continue
        end

        local better, betterDist = GetBestATM()
        if better and better ~= ATM then
            if betterDist < atmDist - 10 or IsATMDisabled(ATM) then
                IsTeleporting = false
                ATM = better
                atmDist = betterDist
                task.wait(recheckRate)
                continue
            end
        end

        local standPos = GetATMStandPos(ATM)
        local distToStand = (Root.Position - standPos).Magnitude

        if IsATMDisabled(ATM) then
            IsTeleporting = false
            local better2, betterDist2 = GetBestATM()
            if not better2 then return false end
            ATM = better2
            atmDist = betterDist2
            task.wait(recheckRate)
            continue
        end

        if distToStand > ATM_INTERACT_DIST then
            IsTeleporting = false
            self._cancelTeleport = false

            local rerouteATM = ATM
            local newRouteATM = nil
            local cancelMove = false

            local rerouteThread = task.spawn(function()
                while not cancelMove do
                    task.wait(0.3)
                    if IsATMDisabled(rerouteATM) then
                        self._cancelTeleport = true
                        IsTeleporting = false
                        cancelMove = true
                        break
                    end
                    local newATM, newDist = GetBestATM()
                    if newATM and newATM ~= rerouteATM then
                        local curDist = (Root.Position - GetATMStandPos(rerouteATM)).Magnitude
                        if newDist < curDist - 10 then
                            newRouteATM = newATM
                            self._cancelTeleport = true
                            IsTeleporting = false
                            cancelMove = true
                            break
                        end
                    end
                end
            end)

            self:Teleport({ CFrame = CFrame.new(standPos) })
            cancelMove = true
            self._cancelTeleport = false
            task.cancel(rerouteThread)

            if newRouteATM then
                ATM = newRouteATM
                atmDist = (Root.Position - GetATMStandPos(ATM)).Magnitude
            end

            task.wait(recheckRate)
        else
            arrived = true
        end
    end

    task.wait(0.3)
    if IsDownedPaused then return false end
    if IsATMDisabled(ATM) then return false end
    self[2].Get("transfer_funds", "hand", "bank", CoreData.money.hand)
    task.wait(1)
    return true
end

