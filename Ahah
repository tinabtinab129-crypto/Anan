local function GetServers()
    local url = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
    local servers = {}
    local cursor
    local attempts = 0
    local maxAttempts = 5

    repeat
        local reqUrl = url
        if cursor then
            reqUrl = reqUrl .. "&cursor=" .. cursor
        end

        local success, res
        local retries = 0

        repeat
            success, res = pcall(function()
                return game:HttpGet(reqUrl)
            end)
            if not success then
                retries += 1
                task.wait(1)
            end
        until success or retries >= 3

        if not success then break end

        local ok, data = pcall(function()
            return HttpService:JSONDecode(res)
        end)

        if not ok or not data or not data.data then break end

        for _, s in ipairs(data.data) do
            local hasSlot = s.playing < s.maxPlayers
            local notEmpty = s.playing > 0
            local notCurrent = s.id ~= game.JobId

            if hasSlot and notEmpty and notCurrent then
                table.insert(servers, s)
            end
        end

        cursor = data.nextPageCursor
        attempts += 1
        task.wait(0.1)

    until not cursor or attempts >= maxAttempts

    return servers
end

local function DoHop(sortFunc, notifyTitle, notifyColor)
    if _G.isHopping then
        WindUI:Notify({
            Title = notifyTitle,
            Content = "Already hopping, please wait...",
            Color = Color3.fromRGB(255, 200, 0)
        })
        return
    end

    _G.isHopping = true

    WindUI:Notify({
        Title = notifyTitle,
        Content = "Fetching servers...",
        Color = Color3.fromRGB(100, 255, 100)
    })

    task.spawn(function()
        local servers = GetServers()

        if sortFunc then
            table.sort(servers, sortFunc)
        end

        local hopped = false

        for _, s in ipairs(servers) do
            if not _G.visitedServers[s.id] then
                _G.visitedServers[s.id] = true

                local ok, err = pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                end)

                if ok then
                    WindUI:Notify({
                        Title = notifyTitle,
                        Content = "Hopping to server with " .. s.playing .. " players",
                        Color = notifyColor
                    })
                    hopped = true
                    break
                else
                    warn("[" .. notifyTitle .. "] Teleport failed:", err)
                    task.wait(0.5)
                end
            end
        end

        if not hopped then
            _G.visitedServers = {}
            WindUI:Notify({
                Title = notifyTitle,
                Content = "No available server found. Visited list cleared.",
                Color = Color3.fromRGB(255, 0, 0)
            })
        end

        task.wait(3)
        _G.isHopping = false
    end)
end

