local function GetATMFrontPos(atm)
    local pivot = atm:GetPivot()
    local area = atm:FindFirstChild("Area")
    local basePos = area and area.Position or pivot.Position
    local frontOffset = ATM_FRONT_OFFSET
    local atmPos = atm:GetPivot().Position
    local isForceRight = false
    for _, v in ipairs(ATM_FORCE_RIGHT_POS) do
        if (atmPos - v).Magnitude < 10 then
            isForceRight = true
            break
        end
    end
    if isForceRight then
        local frontPos = basePos + pivot.LookVector * -9
        return Vector3.new(frontPos.X, basePos.Y, frontPos.Z)
    end
    local isBack = not IsForceFont(atm) and IsBackATM(atm)
    local offset = isBack and ATM_BACK_OFFSET or frontOffset
    local frontPos = basePos + pivot.RightVector * -offset
    if isBack then
        local dirToBase = (basePos - frontPos)
        if dirToBase.Magnitude > 0 then
            frontPos = frontPos + dirToBase.Unit * 1.5
        end
    end
    return Vector3.new(frontPos.X, basePos.Y, frontPos.Z)
end

local function FindBestATM()
    local best, bestDist = nil, math.huge
    for _, obj in next, ModuleATM.class.objects do
        local atm = obj.instance
        if not atm then continue end
        if not IsATMAvailable(atm) then continue end
        local atmPos = atm:GetPivot().Position
        local d = (Root.Position - atmPos).Magnitude
        if d < bestDist then
            best = atm
            bestDist = d
        end
    end
    return best, bestDist
end

