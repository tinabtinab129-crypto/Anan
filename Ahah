end

local function DismountVehicle(self, vehicle)
    if not Humanoid.Sit then return true end
    if vehicle and vehicle.PrimaryPart then
        local clip = vehicle.PrimaryPart:FindFirstChild("CarClip")
        if clip then clip:Destroy() end
        vehicle.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
        vehicle.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
    end
    if self and self[2] then self[2].Get("exit_seat") end
    local t = tick()
    repeat task.wait(0.05) until not Humanoid.Sit or tick() - t > 1
    if Root then
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end
    return not Humanoid.Sit
end

local function TryMountVehicle(v)
    if not v then return false end
    local chassis = v:FindFirstChild("Chassis")
    local dpAttach = chassis and chassis:FindFirstChild("DrivePromptAttachment")
    local dp = dpAttach and dpAttach:FindFirstChild("DrivePrompt")
    if not dp then return false end
    local dist = (Root.Position - dp.Parent.WorldPosition).Magnitude
    if dist > 8 then
        local frontPos = (Root.CFrame * CFrame.new(0, 0, -3)).Position
        v:SetPrimaryPartCFrame(CFrame.new(frontPos))
        task.wait(0.1)
    end
    pcall(function() fireproximityprompt(dp, 1) end)
    local t = tick()
    repeat RunService.Heartbeat:Wait() until Humanoid.Sit or tick() - t > 1
    if Humanoid.Sit and v.PrimaryPart then
        v.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
        v.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
    end
    return Humanoid.Sit
end

local function SpawnAndRideVehicle(self)
    local itemInfo = GetVehicleItemFromInventory()
    if not itemInfo[2] then return false end
    self[2].Send("toggle_equip_item", itemInfo[3])
    task.wait(0.5)
    local vehicle = GetMyVehicle()
    if not vehicle then task.wait(1) vehicle = GetMyVehicle() end
    if not vehicle then return false end
    if TryMountVehicle(vehicle) then return true end

    local isCar = string.lower(_G.VehicleType) == "car"
    local frontPos = (Root.CFrame * CFrame.new(0, 0, isCar and -10 or -5)).Position
    vehicle:SetPrimaryPartCFrame(CFrame.new(frontPos))
    task.wait(0.4)
    return TryMountVehicle(vehicle)
end

local function EnsureOnVehicle(self)
    local v = GetMyVehicle()
    if v and Humanoid.Sit then return v end
    if v and not Humanoid.Sit then
        local mountTries = 0
        repeat
            task.wait(0.3)
            v = GetMyVehicle() or v
            if not v or not v.Parent then break end
            TryMountVehicle(v)
            mountTries += 1
        until Humanoid.Sit or mountTries >= 10
        if Humanoid.Sit then return GetMyVehicle() end
        TeleportService:Teleport(game.PlaceId, Client)
        return nil
    end
    if not SpawnAndRideVehicle(self) then return nil end
    return GetMyVehicle()
end

