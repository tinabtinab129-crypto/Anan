      task.wait(5) return
  end

  local atmFrontPos = GetATMFrontPos(closestATM)
  local isBack = not IsForceFont(closestATM) and IsBackATM(closestATM)
  local arriveThreshold = isBack and 0.5 or ATM_ARRIVE_DIST

  if shortestDist > arriveThreshold then
      ATM_STATE = "DRIVE_TO_ATM"

      local driveTask = task.spawn(function()
          while ATM_STATE == "DRIVE_TO_ATM" do
              task.wait(0.5)
              if IsDownedPaused then _G.StopDriving = true break end
              if not IsATMAvailable(closestATM) then _G.StopDriving = true end
              if self:Detected() then _G.StopDriving = true end
              local newATM, newDist = FindBestATM()
              if newATM and newATM ~= closestATM then
                  local currentDist = (Root.Position - GetATMFrontPos(closestATM)).Magnitude
                  if newDist < currentDist - 25 then
                      closestATM = newATM
                      _G.StopDriving = true
                  end
              end
          end
      end)

      local earlyDismount = false
      local earlyThread = task.spawn(function()
          while ATM_STATE == "DRIVE_TO_ATM" do
              task.wait(0.1)
              if string.lower(_G.VehicleType) == "car" then
                  local checkPos = (vehicle and vehicle.PrimaryPart)
                      and vehicle.PrimaryPart.Position
                      or Root.Position
                  if (checkPos - atmFrontPos).Magnitude <= ATM_EARLY_DISMOUNT_DIST then
                      _G.StopDriving = true
                      earlyDismount = true
                      break
                  end
              end
          end
      end)

      Driveto(self, vehicle, atmFrontPos)
      task.cancel(earlyThread)
      task.cancel(driveTask)
      task.wait(0.1)

      if IsDownedPaused then return end

      local arrived = earlyDismount
          or (Root.Position - atmFrontPos).Magnitude <= ATM_ARRIVE_DIST + 5

      if not arrived then
          if self:Detected() then
              _G.StopDriving = true
              ATM_STATE = "IDLE"
