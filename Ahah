              end)
          end
      else
          local alleyFallback = Vector3.new(-212.181717, 255.525162, 387.744324)
          local alleyTarget = alleyFallback
          local alleyGuy = workspace.Map.NPCs:FindFirstChild("AlleyWayGuy")
          if alleyGuy then
              if alleyGuy.PrimaryPart then
                  alleyTarget = alleyGuy.PrimaryPart.Position
              elseif alleyGuy:FindFirstChildWhichIsA("BasePart") then
