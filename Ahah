function ModuleService:SteakHouse()
    if not Flags.AutoSteak then SteakState = "INIT" return end
    if not self:IsAlive() then return end
    if IsDownedPaused then return end

    local function SteakOK()
        if not self:IsAlive() then return false end
        if IsDownedPaused then return false end
        if self:Detected() then
            IsTeleporting = false
            repeat task.wait(0.5) until not self:Detected() or IsDownedPaused
            return false
        end
        return true
    end

    if self:Detected() then
        IsTeleporting = false
        repeat task.wait(0.5) until not self:Detected() or IsDownedPaused
        if SteakState == "WAIT_JOB"
            or SteakState == "APPLY_JOB"
            or SteakState == "GO_WP"
            or SteakState == "WORK"
        then
            SteakState = "INIT"
        end
        return
    end

    if not SteakOK() then return end
    if not WaitForMap(10) then task.wait(2) return end

    local steakLevel = self:Get_Skill_Level("Cook")
    local skilletName, skilletPrice = GetSkilletInfo(steakLevel)
    if skilletName then
        local itemInfo = GetInfo(skilletName)
        if not itemInfo[2] then
            local handMoney = HandMoney()
            local bankMoney = ATMMoney()
            if handMoney + bankMoney >= skilletPrice then
                if handMoney < skilletPrice then
                    if not SteakOK() then return end
                    WithdrawFromATM(self, skilletPrice - handMoney)
                    return
                end
                local shopZone = workspace:WaitForChild("ShopZone_Hardware", 15)
                if not shopZone then return end
                if self:Dist(shopZone.Position) > 6 then
                    if not SteakOK() then return end
                    self:Teleport({ CFrame = CFrame.new(shopZone.Position) })
                    task.wait(0.5)
                    return
                end
                if not SteakOK() then return end
                self[2].Send("purchase_consumable", shopZone, skilletName)
                task.wait(1)
                return
            end
        end
    end

    if ShouldDeposit() then
        if not SteakOK() then return end
        self:DoDeposit(SteakApplyPos)
        task.wait(0.3)
        if not SteakOK() then return end
        local backPos = (Root.CFrame * CFrame.new(0, 0, 4)).Position
        self:Teleport({ CFrame = CFrame.new(backPos) })
        task.wait(0.3)
        return
    end

    if not SteakOK() then return end

    local job = Client:GetAttribute("Job")

    if job ~= "steakhouse_cook" then
        if SteakState == "INIT" or SteakState == "GO_WP" then
            if self:Dist(SteakOutsidePos) > 6 then
                SteakState = "GO_WP"
                if not SteakOK() then
                    SteakState = "INIT"
                    IsTeleporting = false
                    return
                end
                self:Teleport({ CFrame = CFrame.new(SteakOutsidePos) })
                task.wait(0.3)
                if not SteakOK() then
                    SteakState = "INIT"
                    IsTeleporting = false
                    return
                end
                return
            end
            SteakState = "APPLY_JOB"
            return
        end

        if SteakState == "APPLY_JOB" then
            if self:Dist(SteakOutsidePos) > 6 then
                SteakState = "INIT"
                return
            end
            if not SteakOK() then
                SteakState = "INIT"
                return
            end
            local dist = self:Dist(SteakApplyPos)
            if dist > 2 then
                if self:Dist(SteakPreparePos) > 5 then
                    if not SteakOK() then
                        SteakState = "INIT"
                        return
                    end
                    self:Teleport({ CFrame = CFrame.new(SteakPreparePos) })
                    task.wait(0.3)
                    return
                else
                    Root.CFrame = CFrame.new(SteakApplyPos)
                    task.wait(0.3)
                    return
                end
            end
            local interior = GetSteakInterior()
            if not interior then return end
            if not SteakOK() then
                SteakState = "INIT"
                return
            end
            self[2].Send("apply_for_job", interior.SteakHouseBeacon)
            SteakState = "WAIT_JOB"
            local w1 = tick()
            repeat task.wait(0.2) until tick() - w1 >= 2 or not SteakOK()
            if not SteakOK() then
                SteakState = "INIT"
                return
            end
            if Client:GetAttribute("Job") == "steakhouse_cook" then
                SteakState = "WORK"
            end
            return
        end

        if SteakState == "WAIT_JOB" then
            if not SteakOK() then
                SteakState = "INIT"
                return
            end
            local w2 = tick()
            repeat task.wait(0.2) until tick() - w2 >= 1 or not SteakOK()
            if not SteakOK() then
                SteakState = "INIT"
                return
            end
            if Client:GetAttribute("Job") == "steakhouse_cook" then
                SteakState = "WORK"
            else
                SteakState = "INIT"
            end
            return
        end

        SteakState = "INIT"
        return
    end

    if SteakState ~= "WORK" then SteakState = "WORK" end

    if not SteakOK() then return end

    local steakTool, steakEquipped = GetSteakTool()
    if not steakTool then
        if self:Dist(SteakOrderPos) > 6 then
            if not SteakOK() then return end
            self:Teleport({ CFrame = SteakOrderPos })
            task.wait(0.5)
            return
        end
        if not SteakOK() then return end
        local Interior = GetSteakInterior()
        if not Interior then return end
        for _, v in pairs(Interior.Fridge:GetChildren()) do
            if v:FindFirstChild("Attachment") then
                local prompt = v:FindFirstChild("Attachment"):FindFirstChild("ProximityPrompt")
                if prompt then
                    fireproximityprompt(prompt)
                    break
                end
            end
        end
        if not SteakOK() then return end
        steakTool, steakEquipped = GetSteakTool()
        if not steakTool then
            task.wait(0.2)
            steakTool, steakEquipped = GetSteakTool()
            if not steakTool then return end
        end
        return
    end

    if not SteakOK() then return end
    if not steakEquipped then
        Humanoid:EquipTool(steakTool)
        task.wait(0.3)
    end

    if not SteakOK() then return end

    local Interior = GetSteakInterior()
    if not Interior then return end

    local beaconPos, selectedBeacon = nil, nil
    for _, v in pairs(Interior:GetChildren()) do
        if v.Name == "Beacon" and v.PrimaryPart then
            selectedBeacon = v
            beaconPos = v.PrimaryPart.Position
            break
        end
    end
    if not selectedBeacon or not beaconPos then
        selectedBeacon = workspace:FindFirstChild("Beacon")
        if selectedBeacon and selectedBeacon.PrimaryPart then
            beaconPos = selectedBeacon.PrimaryPart.Position
        end
    end
    if not selectedBeacon or not beaconPos then return end

    if self:Dist(beaconPos) > 5 then
        if not SteakOK() then return end
        self:Teleport({ CFrame = beaconPos })
        task.wait(0.5)
    end

    if not SteakOK() then return end

    local progressFrame = GetProgressBar()
    local tryStart = tick()
    while not (progressFrame and progressFrame.Visible) do
        if not SteakOK() then return end
        if tick() - tryStart > 2 then return end
        for _, v in pairs(Interior:GetChildren()) do
            if v.Name == "Grill" then
                self[2].Send("start_grilling_2", v)
            end
        end
        task.wait(0.3)
        progressFrame = GetProgressBar()
    end

    if not SteakOK() then return end

    local threshold = 0.95
    if skilletName == "GoldenSkillet" and GetInfo("GoldenSkillet")[2] then
        threshold = 0.75
    end

    repeat
        task.wait(0.1)
        if not SteakOK() then return end
    until GetProgressScale() > threshold
        or not (GetProgressBar() and GetProgressBar().Visible)

    if not SteakOK() then return end

    if GetProgressScale() > threshold then
        for _, v in pairs(Interior:GetChildren()) do
            if v.Name == "Grill" then
                self[2].Send("finish_grilling_2", v, "Perfect")
            end
        end
        task.wait(1)
    end
end

